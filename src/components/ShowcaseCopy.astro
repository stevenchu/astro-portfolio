---
import type { CollectionEntry } from 'astro:content';
import ShowcaseArgument from './ShowcaseArgument.astro';

interface Props {
	data: CollectionEntry<'work'>['data'];
	headingLevel: 'h2' | 'h3';
	titleHref?: string;
	showExternalCta?: boolean;
}

const {
	data,
	headingLevel,
	titleHref,
	showExternalCta = false,
} = Astro.props;
const Heading = headingLevel;
---

<div class="showcase-copy">
	<p class="eyebrow">{data.eyebrow}</p>
	<Heading class="title">
		{
			titleHref ? (
				<a
					class="title-link"
					href={titleHref}
					aria-label={data.title}
				>
					{data.title}
				</a>
			) : (
				data.title
			)
		}
	</Heading>
	<ShowcaseArgument class="argument" text={data.showcaseArgument} />

	{
		data.detailAvailability === 'interview-only' ? (
			<p class="detail-note">Public details limited by confidentiality.</p>
		) : showExternalCta && data.externalUrl && data.ctaLabel ? (
			<a
				class="showcase-link"
				href={data.externalUrl}
				target="_blank"
				rel="noreferrer"
				aria-label={`${data.ctaLabel} (opens in a new tab)`}
			>
				{data.ctaLabel}
				<span aria-hidden="true">↗</span>
			</a>
		) : null
	}
</div>

<style>
	.showcase-copy {
		max-width: 46rem;
	}

	/* eyebrow role */
	.eyebrow {
		margin: 0 0 1.25rem;
		font-family: var(--font-display);
		font-size: var(--role-eyebrow-size);
		font-weight: var(--weight-bold);
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
		color: var(--text-tertiary);
	}

	/* title role */
	.title {
		max-width: 22ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--role-title-size);
		font-weight: var(--weight-display);
		letter-spacing: -0.03em;
		line-height: 1.1;
		text-wrap: balance;
		color: var(--text-primary);
	}

	.title-link,
	.title-link:visited {
		color: inherit;
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.title-link:hover {
		color: var(--link-color);
		text-decoration: none;
	}

	.title-link:focus-visible {
		outline: 3px solid var(--accent-dark);
		outline-offset: 0.25rem;
	}

	/* body role */
	:global(.showcase-argument-text.argument) {
		max-width: 58ch;
		margin: 1.75rem 0 0;
		font-size: var(--role-body-size);
		font-weight: var(--weight-body);
		letter-spacing: var(--track-body);
		line-height: 1.65;
		color: var(--text-secondary);
	}

	/* meta role */
	.detail-note {
		margin: 1.5rem 0 0;
		font-size: var(--role-meta-size);
		letter-spacing: var(--track-body);
		line-height: 1.5;
		color: var(--text-tertiary);
	}

	.showcase-link,
	.showcase-link:visited {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.5rem;
		color: var(--link-color);
		font-size: var(--role-body-size);
		font-weight: var(--weight-emphasis);
		letter-spacing: var(--track-body);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
	}

</style>
