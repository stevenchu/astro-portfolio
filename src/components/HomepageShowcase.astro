---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { data, id } = project;
const imagePath = data.img.replace(/^\//, '');
const href = data.externalUrl ?? `/work/${id}`;
const isExternal = Boolean(data.externalUrl);
---

<article class="showcase">
	<header class="showcase-copy">
		<p class="eyebrow">{data.eyebrow}</p>
		<h2>{data.title}</h2>
		<p class="context">{data.showcaseArgument}</p>

		{
			data.detailAvailability === 'interview-only' ? (
				<p class="detail-note">Details available in interview.</p>
			) : data.ctaLabel ? (
				<a
					class="showcase-link"
					href={href}
					target={isExternal ? '_blank' : undefined}
					rel={isExternal ? 'noreferrer' : undefined}
				>
					{data.ctaLabel}
					{isExternal && <span aria-hidden="true">↗</span>}
				</a>
			) : null
		}
	</header>

	<img src={imagePath} alt={data.img_alt || ''} loading="lazy" decoding="async" />
</article>

<style>
	.showcase {
		display: grid;
		gap: 2rem;
		padding: 3rem 1.5rem;
		border: 1px solid var(--gray-0);
		border-radius: 0.75rem;
	}

	.showcase-copy {
		display: grid;
		gap: 0.9rem;
		max-width: 46rem;
	}

	.eyebrow {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	h2 {
		max-width: 22ch;
		margin: 0;
		font-size: var(--text-2xl);
		font-weight: 500;
		letter-spacing: -0.035em;
		line-height: 1.08;
		color: var(--gray-0);
	}

	.context {
		max-width: 54ch;
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.6;
		color: var(--gray-200);
	}

	.detail-note {
		margin: 0.25rem 0 0;
		font-size: var(--text-sm);
		line-height: 1.45;
		color: var(--gray-400);
	}

	.showcase-link {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		gap: 0.4rem;
		margin-top: 0.35rem;
		font-size: var(--text-sm);
		font-weight: 600;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 5 / 3;
		border-radius: 1.5rem;
		object-fit: cover;
		box-shadow: var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.showcase {
			grid-template-columns: 6fr 4fr;
			align-items: center;
			gap: 3.75rem;
			padding: 4.5rem;
			border-radius: 4.5rem;
		}

		h2 {
			font-size: var(--text-3xl);
		}

		img {
			aspect-ratio: 5 / 3;
			/*border-radius: 4.5rem;*/
		}
	}
</style>
