---
import type { CollectionEntry } from 'astro:content';
import ShowcaseCopy from './ShowcaseCopy.astro';
import WorkMedia from './WorkMedia.astro';

interface Props {
	project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { data, id } = project;
const href = `${import.meta.env.BASE_URL}work/${id}`;
const hasInternalDestination =
	data.detailAvailability !== 'external' && data.detailAvailability !== 'interview-only';
const hasExternalDestination = data.detailAvailability === 'external' && Boolean(data.externalUrl);
---

<article class="showcase">
	<header>
		<ShowcaseCopy
			data={data}
			headingLevel="h2"
			titleHref={hasInternalDestination ? href : undefined}
			showExternalCta={hasExternalDestination}
		/>
	</header>

	<WorkMedia
		src={data.img}
		alt={data.img_alt}
		mediaType={data.mediaType}
		poster={data.poster}
		href={hasInternalDestination ? href : undefined}
		linkLabel={
			hasInternalDestination
				? `${data.ctaLabel ?? 'View project'}: ${data.title}`
				: undefined
		}
	/>
</article>

<style>
	.showcase {
		display: grid;
		gap: 2rem;
		padding: 3rem 1.5rem;
		border: 1px solid var(--border-strong);
		border-radius: 0.75rem;
	}

	@media (min-width: 50em) {
		.showcase {
			grid-template-columns: 6fr 4fr;
			align-items: center;
			gap: 3.75rem;
			padding: 4.5rem;
			border-radius: 4.5rem;
		}
	}
</style>
