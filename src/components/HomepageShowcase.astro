---
import type { HomepageShowcase } from '../data/homepageShowcases';

interface Props {
	showcase: HomepageShowcase;
}

const { showcase } = Astro.props;
---

<article class="showcase">
	<header class="showcase-copy">
		<p class="eyebrow">{showcase.eyebrow}</p>
		<h2>{showcase.projectTitle}</h2>
		<p class="context">{showcase.projectContext}</p>

		{
			showcase.detailNote ? (
				<p class="detail-note">{showcase.detailNote}</p>
			) : showcase.href && showcase.ctaLabel ? (
				<a
					class="showcase-link"
					href={showcase.href}
					target={showcase.external ? '_blank' : undefined}
					rel={showcase.external ? 'noreferrer' : undefined}
				>
					{showcase.ctaLabel}
					{showcase.external && <span aria-hidden="true">↗</span>}
				</a>
			) : null
		}
	</header>

	<img src={showcase.image} alt={showcase.imageAlt} loading="lazy" decoding="async" />
</article>

<style>
	.showcase {
		display: grid;
		gap: 2rem;
		padding: 3.5rem 0;
		border-top: 1px solid var(--gray-700); /* deliberately brighter than --border-subtle for this divider; not yet unified */
	}

	.showcase-copy {
		display: grid;
		gap: 0.9rem;
		max-width: 52rem;
	}

	/* eyebrow role */
	.eyebrow {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--role-eyebrow-size);
		font-weight: var(--weight-bold);
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
		color: var(--text-tertiary);
	}

	/* title role */
	h2 {
		max-width: 22ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--role-title-size);
		font-weight: var(--weight-display);
		letter-spacing: -0.03em;
		line-height: 1.1;
		text-wrap: balance;
		color: var(--text-primary);
	}

	/* body role */
	.context {
		max-width: 64ch;
		margin: 0;
		font-size: var(--role-body-size);
		font-weight: var(--weight-body);
		letter-spacing: var(--track-body);
		line-height: 1.55;
		color: var(--text-secondary);
	}

	/* meta role */
	.detail-note {
		margin: 0.25rem 0 0;
		font-size: var(--role-meta-size);
		letter-spacing: var(--track-body);
		line-height: 1.5;
		color: var(--text-tertiary);
	}

	.showcase-link {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		gap: 0.4rem;
		margin-top: 0.35rem;
		font-size: var(--role-body-size);
		font-weight: var(--weight-emphasis);
		letter-spacing: var(--track-body);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		border-radius: 1.5rem;
		object-fit: cover;
		box-shadow: var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.showcase {
			gap: 2.75rem;
			padding: 5rem 0;
		}

		.showcase-copy {
			grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 2fr);
			column-gap: 2.5rem;
			max-width: none;
		}

		.eyebrow {
			grid-column: 1;
			grid-row: 1 / span 3;
			padding-top: 0.35rem;
		}

		h2,
		.context,
		.detail-note,
		.showcase-link {
			grid-column: 2;
		}

		img {
			border-radius: 2.25rem;
		}
	}
</style>
