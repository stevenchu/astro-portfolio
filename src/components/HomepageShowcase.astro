---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { data, id } = project;
const mediaPath = data.img.replace(/^\//, '');
const posterPath = data.poster?.replace(/^\//, '');
const href = data.externalUrl ?? `/work/${id}`;
const isExternal = Boolean(data.externalUrl);
---

<article class="showcase">
	<header class="showcase-copy">
		<p class="eyebrow">{data.eyebrow}</p>
		<h2>{data.title}</h2>
		<p class="context">{data.showcaseArgument}</p>

		{
			data.detailAvailability === 'interview-only' ? (
				<p class="detail-note">Details available in interview.</p>
			) : data.ctaLabel ? (
				<a
					class="showcase-link"
					href={href}
					target={isExternal ? '_blank' : undefined}
					rel={isExternal ? 'noreferrer' : undefined}
				>
					{data.ctaLabel}
					{isExternal && <span aria-hidden="true">↗</span>}
				</a>
			) : null
		}
	</header>

	<div class="showcase-media">
		{
			data.mediaType === 'video' ? (
				<video
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					poster={posterPath}
					aria-label={data.img_alt || undefined}
				>
					<source src={mediaPath} type="video/mp4" />
				</video>
			) : (
				<img src={mediaPath} alt={data.img_alt || ''} loading="lazy" decoding="async" />
			)
		}
	</div>
</article>

<style>
	.showcase {
		display: grid;
		gap: 2rem;
		padding: 3rem 1.5rem;
		border: 1px solid var(--border-strong);
		border-radius: 0.75rem;
	}

	.showcase-copy {
		display: grid;
		gap: 0.9rem;
		max-width: 46rem;
	}

	/* eyebrow role */
	.eyebrow {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--role-eyebrow-size);
		font-weight: var(--weight-bold);
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
		color: var(--text-tertiary);
	}

	/* title role */
	h2 {
		max-width: 22ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--role-title-size);
		font-weight: var(--weight-display);
		letter-spacing: -0.03em;
		line-height: 1.1;
		text-wrap: balance;
		color: var(--text-primary);
	}

	/* body role */
	.context {
		max-width: 64ch;
		margin: 0;
		font-size: var(--role-body-size);
		font-weight: var(--weight-body);
		letter-spacing: var(--track-body);
		line-height: 1.55;
		color: var(--text-secondary);
	}

	/* meta role */
	.detail-note {
		margin: 0.25rem 0 0;
		font-size: var(--role-meta-size);
		letter-spacing: var(--track-body);
		line-height: 1.5;
		color: var(--text-tertiary);
	}

	.showcase-link {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		gap: 0.4rem;
		margin-top: 0.35rem;
		font-size: var(--role-body-size);
		font-weight: var(--weight-emphasis);
		letter-spacing: var(--track-body);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
	}

	.showcase-media {
		width: 100%;
		aspect-ratio: 5 / 3;
		overflow: hidden;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
	}

	.showcase-media > :is(img, video) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 50em) {
		.showcase {
			grid-template-columns: 6fr 4fr;
			align-items: center;
			gap: 3.75rem;
			padding: 4.5rem;
			border-radius: 4.5rem;
		}

		.showcase-media {
			aspect-ratio: 5 / 3;
		}
	}
</style>
