---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { data, id } = Astro.props.project;
const imagePath = data.img.replace(/^\//, '');
---

<a class="card" href={`projects/${id}`}>
	<span class="title">{data.title}<br>
	<small>{data.description}</small></span>
	<img src={imagePath} alt={data.img_alt || ''} loading="lazy" decoding="async" />
</a>

<style>
	.card {
		display: grid;
		grid-template: auto 1fr / auto 1fr;
		height: 11rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--border-subtle);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition: box-shadow var(--theme-transition);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
	}

	/* heading role */
	.title {
		grid-area: 1 / 1 / 2 / 2;
		z-index: 1;
		margin: 0.5rem;
		padding: 0.5rem 1rem;
		font-family: var(--font-display);
		font-size: var(--role-heading-size);
		font-weight: var(--weight-heading);
		letter-spacing: -0.02em;
		line-height: 1.2;
		background: var(--surface-page);
		color: var(--text-secondary);
		border-radius: 0.375rem;
	}

	.title small {
		display: inline-block;
		margin-top: 0.25rem;
		color: var(--text-tertiary);
	}

	img {
		grid-area: 1 / 1 / 3 / 3;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
		}

		.title {
			border-radius: 0.9375rem;
		}
	}
</style>
