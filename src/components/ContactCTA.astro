---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside>
	<h2>I'd love to meet you :)<br><p class="desc">Let's talk over a virtual coffee.</p></h2>
	
	<CallToAction href="mailto:work@stevenchustudio.com?subject=Web%20Inquiry">
		Say Hello 👋
		<Icon icon="paper-plane-tilt" size="1.2em" />
	</CallToAction>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		/*border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);*/
		padding: 5rem 1.5rem;
		background-color: var(--surface-raised);
		box-shadow: var(--shadow-sm);
	}

	/* title role */
	h2 {
		font-size: var(--role-title-size);
		text-align: center;
		max-width: 16ch;
	}

	/* subhead role */
	p.desc {
		font-family: var(--font-body);
		font-size: var(--role-subhead-size);
		font-weight: var(--weight-body);
		letter-spacing: var(--track-body);
		margin-top: 0.5em;
		color: var(--text-secondary);
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		h2 {
			text-align: left;
		}
	}
</style>
