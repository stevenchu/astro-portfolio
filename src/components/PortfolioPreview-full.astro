---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data } = Astro.props.project;
const imagePath = data.img.replace(/^\//, '');
---

<section class="project showcase-card">
	<div class="showcase-content">
		<p class="eyebrow">{data.eyebrow}</p>
		<h3>{data.title}</h3>
		<p class="showcase-argument">{data.showcaseArgument}</p>
	</div>
	<img src={imagePath} alt={data.img_alt || ''} loading="lazy" decoding="async" />
</section>

<style>
	section {
		padding: 3rem 1.5rem;
	}

	.project {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		border: 1px solid var(--gray-0);
		border-radius: 0.75rem;
	}

	.showcase-content {
		max-width: 46rem;
	}

	.eyebrow {
		margin: 0 0 0.9rem;
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	h3 {
		max-width: 22ch;
		margin: 0;
		font-size: var(--text-2xl);
		font-weight: 500;
		letter-spacing: -0.035em;
		line-height: 1.08;
		color: var(--gray-0);
	}

	.showcase-argument {
		max-width: 54ch;
		margin: 0.9rem 0 0;
		font-size: var(--text-base);
		line-height: 1.6;
		color: var(--gray-200);
	}

	.project > img {
		width: 100%;
		height: auto;
		aspect-ratio: 5 / 3;
		border-radius: 1.5rem;
		object-fit: cover;
	}

	@media (min-width: 50em) {
		section {
			padding: 4.5rem;
		}

		.project {
			display: grid;
			grid-template-columns: 6fr 4fr;
			align-items: center;
			gap: 3.75rem;
			border-radius: 4.5rem;
		}

		h3 {
			font-size: var(--text-3xl);
		}

		.project > img {
			aspect-ratio: 5 / 3;
			/*border-radius: 4.5rem;*/
		}
	}
</style>
