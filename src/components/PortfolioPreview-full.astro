---
import type { CollectionEntry } from 'astro:content';
import WorkMedia from './WorkMedia.astro';

interface Props {
	project: CollectionEntry<'work'>;
}

const project = Astro.props.project;
const { data } = project;
const hasInternalDetail =
	data.detailAvailability !== 'external' && data.detailAvailability !== 'interview-only';
const projectHref = `/work/${project.id}/`;
---

{
	hasInternalDetail ? (
		<a
			class="project showcase-card project-link"
			href={projectHref}
			aria-label={`View ${data.title} case study`}
		>
			<div class="showcase-content">
				<p class="eyebrow">{data.eyebrow}</p>
				<h3>{data.title}</h3>
				<p class="showcase-argument">{data.showcaseArgument}</p>
			</div>
			<WorkMedia src={data.img} alt={data.img_alt} mediaType={data.mediaType} poster={data.poster} />
		</a>
	) : (
		<section class="project showcase-card">
			<div class="showcase-content">
				<p class="eyebrow">{data.eyebrow}</p>
				<h3>{data.title}</h3>
				<p class="showcase-argument">{data.showcaseArgument}</p>
			</div>
			<WorkMedia src={data.img} alt={data.img_alt} mediaType={data.mediaType} poster={data.poster} />
		</section>
	)
}

<style>
	section,
	a {
		padding: 3rem 1.5rem;
	}

	.project {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		border: 1px solid var(--border-strong);
		border-radius: 0.75rem;
	}

	.project-link {
		color: inherit;
		text-decoration: none;
		transition:
			transform var(--theme-transition),
			border-color var(--theme-transition);
	}

	.project-link:hover {
		transform: translateY(-0.125rem);
		border-color: var(--text-tertiary);
	}

	.project-link:focus-visible {
		outline: 3px solid var(--accent-dark);
		outline-offset: 0.25rem;
	}

	.showcase-content {
		max-width: 46rem;
	}

	/* eyebrow role */
	.eyebrow {
		margin: 0 0 0.9rem;
		font-family: var(--font-display);
		font-size: var(--role-eyebrow-size);
		font-weight: var(--weight-bold);
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
		color: var(--text-tertiary);
	}

	/* title role */
	h3 {
		max-width: 22ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--role-title-size);
		font-weight: var(--weight-display);
		letter-spacing: -0.03em;
		line-height: 1.1;
		text-wrap: balance;
		color: var(--text-primary);
	}

	/* body role */
	.showcase-argument {
		max-width: 64ch;
		margin: 0.9rem 0 0;
		font-size: var(--role-body-size);
		font-weight: var(--weight-body);
		letter-spacing: var(--track-body);
		line-height: 1.55;
		color: var(--text-secondary);
	}

	@media (prefers-reduced-motion: reduce) {
		.project-link {
			transition: none;
		}

		.project-link:hover {
			transform: none;
		}
	}

	@media (min-width: 50em) {
		section,
		a {
			padding: 4.5rem;
		}

		.project {
			display: grid;
			grid-template-columns: 6fr 4fr;
			align-items: center;
			gap: 3.75rem;
			border-radius: 4.5rem;
		}
	}
</style>
