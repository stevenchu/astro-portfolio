---
import type { CollectionEntry } from 'astro:content';
import ShowcaseCopy from './ShowcaseCopy.astro';
import WorkMedia from './WorkMedia.astro';

interface Props {
	project: CollectionEntry<'work'>;
}

const project = Astro.props.project;
const { data } = project;
const hasInternalDetail =
	data.detailAvailability !== 'external' && data.detailAvailability !== 'interview-only';
const projectHref = `/work/${project.id}/`;
---

{
	hasInternalDetail ? (
		<a
			class="project showcase-card project-link"
			href={projectHref}
			aria-label={`View ${data.title} case study`}
		>
			<ShowcaseCopy data={data} headingLevel="h3" />
			<WorkMedia src={data.img} alt={data.img_alt} mediaType={data.mediaType} poster={data.poster} />
		</a>
	) : (
		<section class="project showcase-card">
			<ShowcaseCopy data={data} headingLevel="h3" />
			<WorkMedia src={data.img} alt={data.img_alt} mediaType={data.mediaType} poster={data.poster} />
		</section>
	)
}

<style>
	section,
	a {
		padding: 3rem 1.5rem;
	}

	.project {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		border: 1px solid var(--border-strong);
		border-radius: 0.75rem;
	}

	.project-link {
		color: inherit;
		text-decoration: none;
		transition:
			transform var(--theme-transition),
			border-color var(--theme-transition);
	}

	.project-link:hover {
		transform: translateY(-0.125rem);
		border-color: var(--text-tertiary);
	}

	.project-link:focus-visible {
		outline: 3px solid var(--accent-dark);
		outline-offset: 0.25rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.project-link {
			transition: none;
		}

		.project-link:hover {
			transform: none;
		}
	}

	@media (min-width: 50em) {
		section,
		a {
			padding: 4.5rem;
		}

		.project {
			display: grid;
			grid-template-columns: 6fr 4fr;
			align-items: center;
			gap: 3.75rem;
			border-radius: 4.5rem;
		}
	}
</style>
