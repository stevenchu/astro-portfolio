---
interface Props {
	src: string;
	alt?: string;
	mediaType?: 'image' | 'video';
	poster?: string;
	href?: string;
	target?: '_blank';
	rel?: string;
	linkLabel?: string;
}

const { src, alt, mediaType = 'image', poster, href, target, rel, linkLabel } = Astro.props;
const MediaContainer = href ? 'a' : 'div';
const withBasePath = (path: string) =>
	path.startsWith('/') && !path.startsWith('//')
		? `${import.meta.env.BASE_URL}${path.slice(1)}`
		: path;
const mediaSrc = withBasePath(src);
const mediaPoster = poster ? withBasePath(poster) : undefined;
---

<MediaContainer
	class:list={['work-media', href && 'work-media--linked']}
	href={href}
	target={target}
	rel={rel}
	aria-label={href ? linkLabel : undefined}
>
	{
		mediaType === 'video' ? (
			<video
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				poster={mediaPoster}
				aria-label={alt || undefined}
			>
				<source src={mediaSrc} type="video/mp4" />
			</video>
		) : (
			<img src={mediaSrc} alt={alt || ''} loading="lazy" decoding="async" />
		)
	}
</MediaContainer>

<style>
	.work-media {
		display: block;
		width: 100%;
		aspect-ratio: 5 / 3;
		overflow: hidden;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
	}

	.work-media--linked {
		color: inherit;
		text-decoration: none;
		transition: transform var(--theme-transition);
	}

	.work-media--linked:hover {
		transform: translateY(-0.125rem);
	}

	.work-media--linked:focus-visible {
		outline: 3px solid var(--accent-dark);
		outline-offset: 0.25rem;
	}

	.work-media > :is(img, video) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (prefers-reduced-motion: reduce) {
		.work-media--linked {
			transition: none;
		}

		.work-media--linked:hover {
			transform: none;
		}
	}
</style>
