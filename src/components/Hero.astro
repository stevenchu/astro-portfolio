---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
	/** 'display' (default) is the full brand statement — homepage, About.
	 *  'page' is for wayfinding titles that should get out of the way and
	 *  let the content lead — case study / project interiors. */
	size?: 'display' | 'page';
}

const { align = 'center', size = 'display', tagline, title } = Astro.props;

---

<header class:list={['hero stack gap-4', align]}>
	<div class="stack gap-8">
		<slot name="pre-title"/>
		<h1 class:list={['title', size]}>{title}</h1>
		<!--{tagline && <p class="tagline">{tagline}</p>}-->
		{tagline && <p class="tagline" set:html={tagline} />}

	</div>
	<slot />
</header>

<style>
	.hero {
		font-size: var(--role-body-size);
		text-align: left;
	}

	/* Measure is set per role, in that role's own ch units — a single
	   max-width on the container would be computed against body size and
	   throttle the display headline into too many lines. */
	.title {
		max-width: 16ch;
		margin-inline: auto;
	}

	.tagline {
		max-width: 46ch;
		margin-inline: auto;
	}

	/* .start (left-aligned hero) should stay left-aligned at every width —
	   text-align alone doesn't uncenter a block with margin-inline: auto. */
	.start .title,
	.start .tagline {
		margin-inline: unset;
	}

	/* display role */
	.title {
		font-family: var(--font-display);
		font-size: var(--role-display-size);
		font-weight: var(--weight-display);
		line-height: 1.05;
		letter-spacing: -0.04em;
		text-wrap: balance;
		color: var(--text-primary);
	}

	/* Case-study / project title — same title role used for showcase
	   headlines and section openers elsewhere, so a case-study page title
	   doesn't compete with the homepage's brand statement. */
	.title.page {
		font-size: var(--role-title-size);
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	/* subhead role */
	.tagline {
		font-size: var(--role-subhead-size);
		font-weight: var(--weight-body);
		letter-spacing: var(--track-body);
		line-height: 1.5;
		color: var(--text-secondary);
	}

	@media (min-width: 20em) {
		a {
			font-size: var(--text-md);
		}
	}
	
	@media (min-width: 50em) {
		.start {
			text-align: start;
		}
		/* .title sizing is handled by the display role's clamp() — no
		   breakpoint override, or it would defeat the fluid scale. */
	}
</style>
