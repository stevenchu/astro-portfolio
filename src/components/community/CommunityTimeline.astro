---
import { communitySectionContent, type CommunityProgram } from '../../data/community-programs';
import CommunityProgramMedia from './_components/CommunityProgramMedia.astro';

type Props = { programs: CommunityProgram[] };
const { programs } = Astro.props;

const getDetails = (program: CommunityProgram) => {
	const parts = [];
	if (program.organization && program.organization !== program.categoryLabel) parts.push(program.organization);
	if (program.location) parts.push(program.location);
	return parts.join(' · ');
};
---

<section class="community-timeline" aria-labelledby="community-timeline-title">
	<header class="timeline-heading stack gap-2">
		<h2 id="community-timeline-title">{communitySectionContent.title}</h2>
		<p class="lede">{communitySectionContent.timelineLede}</p>
	</header>

	<div class="timeline">
		{programs.map((program) => (
			<article class="timeline-entry">
				<div class="timeline-date">
					<p>{program.date}</p>
				</div>
				<div class="timeline-content">
					<div class="timeline-copy stack gap-2">
						<p class="eyebrow">{program.categoryLabel} · {program.role}<span class="mobile-date"> · {program.date}</span></p>
						<h3>{program.title}</h3>
						<p>{program.summary}</p>
						{getDetails(program) && <p class="details">{getDetails(program)}</p>}
						{program.href && <a href={program.href} target="_blank" rel="noreferrer">View event <span aria-hidden="true">↗</span></a>}
					</div>
					<CommunityProgramMedia label={program.mediaLabel} imageSrc={program.imageSrc} imageAlt={program.imageAlt} />
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.community-timeline { display: grid; gap: clamp(2.5rem, 6vw, 5rem); }
	.timeline-heading { max-width: 48rem; }
	.eyebrow { margin: 0; font-family: var(--font-display); font-size: var(--role-eyebrow-size); font-weight: var(--weight-bold); letter-spacing: .12em; text-transform: uppercase; color: var(--text-secondary); }
	h2 { margin: 0; font-family: var(--font-display); font-size: var(--role-title-size); font-weight: var(--weight-heading); line-height: 1.08; letter-spacing: -.035em; }
	.lede { display: none; margin: 0; max-width: 42rem; font-size: var(--text-lg); color: var(--text-secondary); }
	.timeline { position: relative; display: grid; gap: 3rem; }
	.timeline-entry { display: grid; gap: 1rem; }
	.timeline-date { display: none; }
	.timeline-date p { margin: 0; color: var(--text-secondary); }
	.mobile-date { display: inline; }
	.timeline-content { display: grid; gap: 1.5rem; padding-bottom: 3rem; border-bottom: 1px solid var(--border-strong); }
	h3 { margin: 0; font-family: var(--font-display); font-size: clamp(1.75rem, 4vw, 3rem); font-weight: var(--weight-heading); line-height: 1.08; letter-spacing: -.035em; }
	.timeline-copy p { margin: 0; }
	.details { color: var(--text-secondary); }
	a { width: fit-content; color: var(--text-primary); font-weight: var(--weight-bold); text-underline-offset: .25em; }
	@media (min-width: 50em) {
		.lede { display: block; }
		.timeline-entry { grid-template-columns: minmax(8rem, .35fr) 1.65fr; gap: 2.5rem; }
		.timeline-date { display: block; }
		.mobile-date { display: none; }
		.timeline-content { grid-template-columns: .9fr 1.1fr; gap: 2rem; }
	}
</style>
