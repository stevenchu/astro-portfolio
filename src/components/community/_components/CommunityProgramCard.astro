---
import type { CommunityProgram } from '../../../data/community-programs';
import CommunityProgramMedia from './CommunityProgramMedia.astro';

type Props = {
	program: CommunityProgram;
	headingLevel?: 'h3' | 'h4';
	variant?: 'standard' | 'interest';
	mediaVariant?: 'standard' | 'interest-supporting';
};

const { program, headingLevel = 'h3', variant = 'standard', mediaVariant = 'standard' } = Astro.props;
const Heading = headingLevel;
---

<article class:list={['community-card', `community-card--${variant}`]}>
	<CommunityProgramMedia
		label={program.mediaLabel}
		imageSrc={program.imageSrc}
		imageAlt={program.imageAlt}
		variant={mediaVariant}
	/>
	<div class="community-card__copy stack gap-2">
		{(variant !== 'interest' || program.homepageLabel) && <p class="community-card__meta">{program.homepageLabel ?? `${program.categoryLabel} · ${program.role}`}</p>}
		<Heading>{program.homepageTitle ?? program.title}</Heading>
		{program.homepageSubtitle && <p class="community-card__subtitle">{program.homepageSubtitle}</p>}
		<p>{program.homepageSummary ?? program.shortSummary}</p>
		{
			program.href && (
				<a href={program.href} target="_blank" rel="noreferrer">
					View event <span aria-hidden="true">↗</span>
				</a>
			)
		}
	</div>
</article>

<style>
	.community-card {
		display: grid;
		gap: 1.25rem;
		padding: 1.25rem;
		border: 1px solid var(--border-strong);
		border-radius: 1.75rem;
		background: var(--surface-page);
	}

	.community-card__meta {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--role-eyebrow-size);
		font-weight: var(--weight-bold);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	.community-card__subtitle {
		margin: 0;
		color: var(--text-secondary);
	}

	h3,
	h4 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		font-weight: var(--weight-heading);
		line-height: 1.1;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	p {
		margin: 0;
	}

	a {
		width: fit-content;
		color: var(--text-primary);
		font-weight: var(--weight-bold);
		text-underline-offset: 0.25em;
	}

	.community-card--interest {
		gap: 1rem;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		align-items: normal;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
	}

	.community-card--interest h3,
	.community-card--interest h4 {
		font-size: clamp(1.4rem, 2.1vw, 1.85rem);
	}

	.community-card--interest .community-card__copy {
		gap: 0.6rem;
	}

	@media (min-width: 51.25em) {
		.community-card--interest {
			grid-template-columns: minmax(8.5rem, 0.55fr) 1fr;
			align-items: center;
			gap: 1.5rem;
		}
	}
</style>
