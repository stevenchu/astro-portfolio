---
import type { CommunityProgram } from '../../../data/community-programs';
import CommunityProgramMedia from './CommunityProgramMedia.astro';

type Props = {
	program: CommunityProgram;
	headingLevel?: 'h3' | 'h4';
};

const { program, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="community-card">
	<CommunityProgramMedia
		label={program.mediaLabel}
		imageSrc={program.imageSrc}
		imageAlt={program.imageAlt}
	/>
	<div class="community-card__copy stack gap-2">
		<p class="community-card__meta">{program.categoryLabel} · {program.role}</p>
		<Heading>{program.title}</Heading>
		<p>{program.shortSummary}</p>
		{
			program.href && (
				<a href={program.href} target="_blank" rel="noreferrer">
					View event <span aria-hidden="true">↗</span>
				</a>
			)
		}
	</div>
</article>

<style>
	.community-card {
		display: grid;
		gap: 1.25rem;
		padding: 1.25rem;
		border: 1px solid var(--border-strong);
		border-radius: 1.75rem;
		background: var(--surface-page);
	}

	.community-card__meta {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--role-eyebrow-size);
		font-weight: var(--weight-bold);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	h3,
	h4 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		font-weight: var(--weight-heading);
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	p {
		margin: 0;
	}

	a {
		width: fit-content;
		color: var(--text-primary);
		font-weight: var(--weight-bold);
		text-underline-offset: 0.25em;
	}
</style>
