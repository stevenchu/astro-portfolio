---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import Hero from '../components/Hero.astro';
import CommunityTimeline from '../components/community/CommunityTimeline.astro';
import { aboutCommunityPrograms } from '../data/community-programs';
---

<BaseLayout title="About | Steven Chu" description="About Steven Chu">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero title="Well hello! I'm Steven" tagline=""></Hero>

			<section class="gap-20 lg:gap-40">
				<h2 class="section-title">Product Design Background</h2>
				<div class="content">
					<p class="lede">
						I’ve spent more than 10 years designing products and systems across creative tools, learning, and enterprise software. My background spans product design, design systems, interaction design, front-end coding, and—more recently—AI-assisted product development, from early-stage concepts to complex platforms used at scale.
					</p>

					<br />

					<p>Most recently, I architected institution-level theming for a shared financial-services platform and designed AI-assisted search for an enterprise logistics platform. I’ve also used AI-assisted development workflows to independently build and launch BodyMap in three weeks. The computer-vision tool helps movement teachers turn student videos into clear, visual coaching feedback.</p>
					<p>At Bose, I led product design for the site experience and owned the design system. Earlier, I led design operations and brand at Motif Photos, solved internal workflow problems for UNIQLO, and got my UX start at Marie Forleo, designing the pathways that helped aspiring women entrepreneurs move from free educational content toward the confidence and readiness to enroll in B-School.</p>
					<p>I started my career in brand, art direction, and experiential design at Jack Morton, FCB, and Deutsch, working on brands including IKEA and Olympus before moving into digital product design.</p>
					<p>Outside of design, I teach aerial arts and produce intergenerational LGBTQ+ storytelling programs through Out in Tech and The Generations Project. Designing, teaching, and community-building all draw from the same belief: meet people where they are, create welcoming ways in, and support different ways of learning and participating.</p>
					<img
						width="800"
						height="450"
						src="images/about-me.jpg"
						alt="Steven Chu teaching kayaking"
					/>
					<br /><br />
					<div class="ctas">
						<CallToAction href="mailto:work@stevenchustudio.com?subject=Web%20Inquiry" style="small">
							Say Hello
							<Icon icon="paper-plane-tilt" size="1.2em" />
						</CallToAction>
					</div>
					<br />
				</div>
			</section>

			<div class="principles-section">
				<div class="principles-heading">
					<h2>Principles I work by</h2>
				</div>
				<div class="principles">
					<article class="principle">
						<span class="principle-number">01</span>
						<h3>Help people explore, learn, and grow</h3>
					</article>
					<article class="principle">
						<span class="principle-number">02</span>
						<h3>Tackle ambiguous problems by establishing a structure teams can build from.</h3>
					</article>
					<article class="principle">
						<span class="principle-number">03</span>
						<h3>Build early to expose constraints and test possibilities.</h3>
					</article>
				</div>
			</div>

			<div class="community-section">
				<CommunityTimeline programs={aboutCommunityPrograms} />
			</div>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.lede {
		font-family: var(--font-body);
		font-size: 1.5rem;
		font-weight: var(--weight-body);
		letter-spacing: var(--track-body);
		line-height: 1.45;
		color: var(--text-primary);
		max-width: 54ch;
	}

	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.section-title {
		grid-column-start: 1;
		font-family: var(--font-display);
		font-size: var(--role-heading-size);
		font-weight: var(--weight-heading);
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: var(--text-primary);
	}

	.principles-section {
		grid-column: 1 / -1;
		padding-block: clamp(2.5rem, 5vw, 4.5rem);
	}

	.principles-heading {
		margin-bottom: 2rem;
	}

	.principles-heading h2 {
		font-family: var(--font-display);
		font-size: var(--role-heading-size);
		font-weight: var(--weight-heading);
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: var(--text-primary);
	}

	.principles {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
	}

	.principle-number {
		display: block;
		margin-bottom: 0.875rem;
		font-family: var(--font-display);
		font-size: var(--role-eyebrow-size);
		font-weight: var(--weight-bold);
		letter-spacing: 0.12em;
		line-height: 1.4;
		color: var(--text-tertiary);
	}

	.principle h3 {
		font-family: var(--font-display);
		font-size: var(--role-title-size);
		font-weight: var(--weight-heading);
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: var(--text-primary);
	}

	.community-section {
		grid-column: 1 / -1;
		margin-block: clamp(2rem, 5vw, 5rem);
	}

	.ctas { margin-top: 1rem; }
	.cols-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); grid-gap: 2em; font-size: 1rem; }
	p { margin-bottom: 1em; }
	.content { grid-column: 2 / 4; max-width: 48ch; }
	.content :global(a) { text-decoration: 1px solid underline transparent; text-underline-offset: 0.25em; transition: text-decoration-color var(--theme-transition); }
	.content :global(a:hover), .content :global(a:focus) { text-decoration-color: currentColor; }

	@media (min-width: 50em) {
		.ctas { margin-top: 0.5rem; display: flex; gap: 0.5rem; }
		.about { display: grid; grid-template-columns: 1fr 60% 1fr; }
		.about > :global(:first-child) { grid-column-start: 2; }
		section { display: contents; font-size: var(--text-lg); }
		.principles {
			grid-template-columns: 1fr;
			gap: clamp(3rem, 5vw, 5rem);
		}
		.principle {
			display: grid;
			grid-template-columns: minmax(8rem, 0.35fr) 1.65fr;
			gap: 2.5rem;
			align-items: start;
		}
		.principle-number {
			margin-bottom: 0;
			padding-top: 0.5rem;
		}
		.community-section { display: block; }
	}
</style>
