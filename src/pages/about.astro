---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import CommunityProgramMedia from '../components/community/_components/CommunityProgramMedia.astro';
import { aboutCommunityPrograms } from '../data/community-programs';
import { Picture } from 'astro:assets';
import heroPortrait from '../assets/about/steven-utah.jpg';
import oaxaca from '../assets/about/about-oaxaca.jpeg';
import teo from '../assets/about/about-teo.JPG';
import madamBrett from '../assets/about/about-madambrett.jpg';

const galleryImages = [
	{ src: oaxaca, alt: 'Steven Chu outdoors in Oaxaca.' },
	{ src: madamBrett, alt: 'Steven Chu outdoors at Madam Brett Park.' },
	{ src: teo, alt: 'Steven Chu with Teo.' },
];

const principles = [
	'Help people explore, learn, and grow.',
	'Tackle ambiguous problems by establishing a structure teams can build from.',
	'Build early to expose constraints and test possibilities.',
];

// No real event photo available for these two — run text-only, full width,
// rather than force a mismatched graphic or a sparse photo into the 60/40 media slot.
const aboutTextOnlyProgramIds = ['designing-belonging', 'focus-and-flow'];
---

<BaseLayout
	title="Steven Chu | Staff Product Designer"
	description="Staff Product Designer Steven Chu works across product systems, visual craft, and implementation, with experience spanning enterprise software, ecommerce, and creative tools."
>
	<main class="wrapper about-page">
		<section class="hero">
			<div class="hero__copy">
				<p class="t-eyebrow">About</p>
				<h1 class="t-title">Well hello, I&apos;m Steven</h1>
				<p class="t-subhead hero__subhead">Staff Product Designer across systems, visual craft, and implementation.</p>
				<div class="hero__body">
					<p>I&apos;ve spent more than 10 years designing products and systems across enterprise software, ecommerce, and creative tools. I work on problems that are still in motion, creating enough structure for teams to make confident decisions and keep building.</p>
					<p>Most recently, I architected theming and customization for a banking platform that powers 1,300 banks and credit unions, designed conversational search for a global supply-chain platform, and led product design for Bose&apos;s ecommerce experience while owning the design system and integrating brand storytelling into product discovery and the purchase journey.</p>
					<p>My design practice has always extended into how things get built. I have a background in front-end development and recently used AI-assisted workflows to independently design and launch BodyMap in three weeks, a computer-vision coaching tool that helps movement instructors turn student video into clear visual feedback they can annotate and share. My career began in brand, art direction, and experiential design before expanding into UX strategy, design operations, and product design.</p>
				</div>
				<CallToAction href="mailto:work@stevenchustudio.com?subject=Web%20Inquiry" style="small">Say Hello 👋</CallToAction>
			</div>
			<Picture class="hero__portrait" src={heroPortrait} alt="Steven Chu outdoors in Utah." widths={[320, 480, 640, 960, 1280, 1600]} sizes="(min-width: 50em) 40vw, 100vw" formats={['avif', 'webp']} />
		</section>

		<section class="photo-strip" aria-label="Photos of Steven">
			{galleryImages.map((image) => <Picture src={image.src} alt={image.alt} widths={[320, 480, 640, 960, 1280]} sizes="(min-width: 50em) 31vw, 33vw" formats={['avif', 'webp']} />)}
		</section>

		<section class="rail-section">
			<h2 class="t-heading">Principles I work by</h2>
			<ol class="principles">
				{principles.map((principle, index) => (
					<li>
						<span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
						<p>{principle}</p>
					</li>
				))}
			</ol>
		</section>

		<section class="rail-section community">
			<h2 class="t-heading">Community, talks, and teaching</h2>
			<div class="community__entries">
				{aboutCommunityPrograms.map((program) => {
					const textOnly = aboutTextOnlyProgramIds.includes(program.id);
					return (
						<article class:list={['community-entry', { 'community-entry--text-only': textOnly }]}>
							<div class="community-entry__copy">
								<p class="t-eyebrow">{program.date} · {program.categoryLabel} · {program.role}</p>
								<h3>{program.title}</h3>
								<p class="t-body">{program.id === 'queer-tech-stories' ? 'An intergenerational storytelling series I created to bring queer technologists together to share the experiences and turning points that shaped their lives and careers.' : program.summary}</p>
							</div>
							{!textOnly && (
								<CommunityProgramMedia label={program.mediaLabel} imageSrc={program.imageSrc} imageAlt={program.imageAlt} class="about-community-media" />
							)}
						</article>
					);
				})}
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.about-page { display: flex; flex-direction: column; gap: 5rem; padding-block: 2.5rem 5rem; }
	.hero, .rail-section { display: grid; gap: 2.5rem; }
	.hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; }
	.hero__subhead { max-width: 42ch; }
	.hero__body { display: flex; flex-direction: column; gap: 1rem; max-width: 52ch; color: var(--text-primary); line-height: 1.6; }
	.hero__portrait, .photo-strip :global(picture), .photo-strip :global(img) { display: block; width: 100%; object-fit: cover; }
	.hero__portrait { aspect-ratio: 3 / 4; border-radius: 1.5rem; }
	.photo-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; }
	.photo-strip :global(img) { aspect-ratio: 4 / 3; border-radius: .75rem; object-fit: cover; }
	.principles, .community__entries { display: flex; flex-direction: column; margin: 0; padding: 0; list-style: none; }
	.principles { gap: 2rem; }
	.principles li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; align-items: baseline; }
	.principles span { color: var(--accent); font-family: var(--font-display); font-size: var(--role-eyebrow-size); font-weight: var(--weight-bold); }
	.principles p { font-family: var(--font-display); font-size: clamp(1.35rem, 2.6vw, 1.75rem); font-weight: var(--weight-heading); letter-spacing: -.02em; line-height: 1.25; }
	.community__entries { gap: 3rem; }
	.community-entry { display: grid; gap: 1.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--border-subtle); }
	.community-entry:last-child { padding-bottom: 0; border-bottom: 0; }
	.community-entry--text-only { max-width: 60ch; }
	.community-entry__copy { display: flex; flex-direction: column; align-items: flex-start; gap: .75rem; }
	.community-entry h3 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: var(--weight-heading); letter-spacing: -.02em; line-height: 1.15; }
	:global(.about-community-media) { width: 100%; min-width: 0; max-width: 100%; aspect-ratio: 4 / 3; border-radius: 1rem; }
	:global(.community-entry .about-community-media) { min-height: 0; }
	:global(.community-entry .about-community-media .community-media__primary) { min-height: 0; height: 100%; }

	@media (min-width: 50em) {
		.hero { grid-template-columns: minmax(0, 6fr) minmax(0, 4fr); align-items: center; gap: 2.75rem; }
		.rail-section { grid-template-columns: minmax(8rem, .35fr) 1fr; gap: 2.5rem; }
		.community-entry:not(.community-entry--text-only) { grid-template-columns: minmax(0, 6fr) minmax(0, 4fr); align-items: center; gap: 2rem; }
	}
</style>
