---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview-full.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';

// /work lists every case study in reverse-chronological order — it's the
// canonical archive, not the homepage's curated subset. homepageOrder is
// a homepage-only concern (see index.astro) and has no bearing here.
const projects = (await getCollection('work')).sort(
	(a, b) => (b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0)
);
---

<BaseLayout
	title="My Work | Steven Chu"
	description="Learn about Steven Chu's most recent projects"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Work"
				tagline=""
				align="start"
			/>
					<Grid variant="full">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
