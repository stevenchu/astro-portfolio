---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview-full.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';

const projects = (await getCollection('work')).sort((a, b) => {
	const featuredOrderA = a.data.featuredOrder ?? Number.POSITIVE_INFINITY;
	const featuredOrderB = b.data.featuredOrder ?? Number.POSITIVE_INFINITY;

	return (
		featuredOrderA - featuredOrderB ||
		(b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0)
	);
});
---

<BaseLayout
	title="My Work | Steven Chu"
	description="Learn about Steven Chu's most recent projects"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Work"
				tagline=""
				align="start"
			/>
					<Grid variant="full">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
